{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sofapaint-mcp",
  "main": "../src/modules/measurement-assistant/mcp/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Bound image-render CPU per request; daily quotas also cap aggregate use.
  "limits": { "cpu_ms": 3000 },
  "vars": {
    "EDITOR_URL": "https://sofapaint.vercel.app/",
    "ALLOWED_ORIGINS": "https://sofapaint.vercel.app,https://sofapaint-leigh-atkins-projects.vercel.app,http://127.0.0.1:5173,http://localhost:5173",
    "ALLOWED_IMAGE_HOSTS": "files.oaiusercontent.com,oaiusercontent.com,sofapaint.vercel.app,oaisdmntprseasia.blob.core.windows.net,oaisdmntprindiasocentral.blob.core.windows.net,s3-us-west-1.amazonaws.com",
    "LOCAL_DEVELOPMENT": "false",
    "PUBLIC_MCP_ENABLED": "true",
    "OPENAI_DOMAIN_CHALLENGE": "P7IvbeeG7IDOKhCvCeN2V7LlhTmbZcUwbD1D-2sl8x8",
  },
  "durable_objects": { "bindings": [{ "name": "USAGE_BUDGET", "class_name": "UsageBudget" }] },
  "migrations": [{ "tag": "v1-budget", "new_sqlite_classes": ["UsageBudget"] }],
  "r2_buckets": [
    {
      "binding": "DRAFTS",
      "bucket_name": "sofapaint-mcp-drafts",
    },
    {
      "binding": "MEASUREMENT_GUIDES",
      "bucket_name": "openpaint-measurement-guides",
    },
  ],
  "assets": {
    "binding": "GUIDES",
    "directory": "../dist/mcp-guides",
    "run_worker_first": true,
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0.1,
  },
}
